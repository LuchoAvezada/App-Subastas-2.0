{"nodes": [{"id": "design_system_subasta_agrotec_master_design_system", "label": "Design System Subasta Agrotec", "file_type": "document", "source_file": "design-system/subasta-agrotec/MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark mode queda light-only por ahora (herramienta interna; no expandir el alcance del overhaul); se descarta el patron landing 'Product Demo + Features' por ser una app interna autenticada, no una landing."}, {"id": "design_system_subasta_agrotec_master_swiss_style", "label": "Minimalism & Swiss Style", "file_type": "rationale", "source_file": "design-system/subasta-agrotec/MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Estilo base recomendado para enterprise apps, dashboards, SaaS y herramientas profesionales; se adopta su estructura (neutros + estados semanticos, sombras y radios reducidos) aunque no su color de ejemplo."}, {"id": "design_system_subasta_agrotec_master_uiux_pro_max", "label": "UI/UX Pro Max", "file_type": "concept", "source_file": "design-system/subasta-agrotec/MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_system_subasta_agrotec_master_agrotec_palette", "label": "Paleta de marca Agrotec", "file_type": "concept", "source_file": "design-system/subasta-agrotec/MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se conserva el verde de marca agrotec (#00753b/#005a2b) sobre el teal #0D9488 de ejemplo de la skill: la paleta corporativa es identidad de marca (FASE 8/9: preservar). Se adopta solo la estructura Swiss (neutros + estados semanticos), no el color de ejemplo."}, {"id": "design_system_subasta_agrotec_master_inter_font", "label": "Tipografia Inter", "file_type": "concept", "source_file": "design-system/subasta-agrotec/MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se conserva Inter en vez de Plus Jakarta Sans/Lexend: ya esta cargada, es la sans enterprise legible que la propia skill endosa, y cambiarla seria churn de marca sin beneficio ademas de sumar otra fuente."}, {"id": "design_system_subasta_agrotec_master_tailwind_tokens", "label": "Tokens Tailwind (fuente unica de verdad)", "file_type": "concept", "source_file": "design-system/subasta-agrotec/MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_system_subasta_agrotec_master_semantic_colors", "label": "Roles semanticos de color", "file_type": "concept", "source_file": "design-system/subasta-agrotec/MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_system_subasta_agrotec_master_radius_scale", "label": "Escala de radios", "file_type": "concept", "source_file": "design-system/subasta-agrotec/MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Escala estandarizada de radios para eliminar el 'zoo' de radios (controles 8px, cards/modal 16px, pills full, hero 24px como excepcion intencional)."}, {"id": "design_system_subasta_agrotec_master_shadow_scale", "label": "Escala de sombras", "file_type": "concept", "source_file": "design-system/subasta-agrotec/MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Escala reducida de sombras siguiendo Swiss ('sharp shadows if any'): sm reposo, md hover, lg overlays; evitar xl/2xl salvo modal/hero."}, {"id": "design_system_subasta_agrotec_master_motion", "label": "Motion (transiciones)", "file_type": "rationale", "source_file": "design-system/subasta-agrotec/MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se usan CSS transitions/keyframes existentes en vez de GSAP/ScrollTrigger: no se anade una dependencia solo por estetica (FASE 9). 150-250ms ease-out, prefers-reduced-motion, y no animar width/height/top/left."}, {"id": "design_system_subasta_agrotec_master_component_rules", "label": "Reglas de componente (a11y)", "file_type": "rationale", "source_file": "design-system/subasta-agrotec/MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_system_subasta_agrotec_master_anti_patterns", "label": "Anti-patterns", "file_type": "rationale", "source_file": "design-system/subasta-agrotec/MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_system_subasta_agrotec_master_checklist", "label": "Pre-Delivery Checklist", "file_type": "concept", "source_file": "design-system/subasta-agrotec/MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "design_system_subasta_agrotec_master_design_system", "target": "design_system_subasta_agrotec_master_uiux_pro_max", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-system/subasta-agrotec/MASTER.md", "source_location": null, "weight": 1.0}, {"source": "design_system_subasta_agrotec_master_design_system", "target": "design_system_subasta_agrotec_master_swiss_style", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "design-system/subasta-agrotec/MASTER.md", "source_location": null, "weight": 1.0}, {"source": "design_system_subasta_agrotec_master_design_system", "target": "design_system_subasta_agrotec_master_tailwind_tokens", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file